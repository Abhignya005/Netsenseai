# NetSense — environment variables (copy to .env and edit if needed)
#
# NetSense needs NO secrets to run. Every variable below is optional:
# unset values fall back to the defaults documented in
# backend/config.py. Never commit a real .env file.

# --- Database ---------------------------------------------------------
# Full path to the SQLite database file. Default: backend/netsense.db
NETSENSE_DB_PATH=

# --- API server -------------------------------------------------------
# Bind host/port for the FastAPI backend. Defaults: 127.0.0.1:8001
# (port 8000 is intentionally avoided — see README).
NETSENSE_API_HOST=
NETSENSE_API_PORT=

# --- CORS -------------------------------------------------------------
# Where the frontend is served from. Default: http://localhost:5173
NETSENSE_FRONTEND_ORIGIN=

# --- Machine learning -------------------------------------------------
# Dataset CSVs (CICIDS2017) and trained models live in ml/data and
# ml/models — see ml/README.md. No API keys, passwords, or tokens are
# used anywhere in NetSense.
