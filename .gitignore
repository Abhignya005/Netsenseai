# NetSense Python
backend/venv/
backend/__pycache__/
backend/**/__pycache__/
ml/__pycache__/
**/__pycache__/
*.pyc

# SQLite runtime data (never commit captured metadata)
backend/netsense.db
backend/netsense.db-wal
backend/netsense.db-shm
*.sqlite3

# Trained ML models are reproducible artifacts (retrain with ml/ scripts)
ml/models/*.joblib
ml/models/training_metrics.json

# Large datasets: the demo CSV is committed; real CICIDS2017 (GBs) is not
ml/data/*
!ml/data/SAMPLE_demo_cicids2017_schema.csv
!ml/data/PUT_DATASET_HERE.txt

# Frontend
frontend/node_modules/
frontend/dist/

# Environment & editors
.env
.vscode/
.idea/
*.log
